[memory]
# blst: the field arithmetic is assembly on x86_64/aarch64 (there is no
# portable-C build on 64-bit targets), so MSan cannot see its stores and
# would report its outputs as uninitialised. The C++ wrappers in
# src/blsct/arith/blst/ zero-initialise every blst output object before
# handing it to the library, which keeps the shadow clean — those wrappers
# must therefore stay INSTRUMENTED (their memsets are what unpoisons the
# memory); only the library itself is suppressed.
src:*/src/blst/*
fun:blst_*
# false-positive in secp256k1 crypto operations (scalar_reduce_512,
# scalar_mul, ecdsa_sig_sign): the library manually manages
# initialization of internal scratch buffers in ways MSan does not track.
src:*/src/secp256k1/*
